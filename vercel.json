{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/collect", "destination": "/collect.html" },
    { "source": "/vault", "destination": "/vault.html" },
    { "source": "/portfolio", "destination": "/portfolio.html" },
    { "source": "/links", "destination": "/links.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
